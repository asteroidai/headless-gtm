# Server
PORT=5005
# Protects /jobs/run, /pulls/*/run and /admin/*. Leave empty on a laptop; set it in production.
ADMIN_TOKEN=

# Claude. One of the two. A subscription token comes from `claude setup-token`.
# Check Anthropic's terms for the way you use it.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Path to the claude binary when it is not on PATH.
CLAUDE_BIN=claude

# Signals
CALCOM_WEBHOOK_SECRET=
SIGNUP_SECRET=
RB2B_TOKEN=

# Pulls
GITHUB_TOKEN=

# Tools
EXA_API_KEY=
APOLLO_API_KEY=

# Writes
ATTIO_API_KEY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#gtm
